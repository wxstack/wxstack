{
  "name": "@wxstack/pay",
  "version": "0.1.0",
  "description": "微信支付 v3 SDK",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint:pkg": "publint && attw --pack . --profile node16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxstack/wxstack.git",
    "directory": "packages/pay"
  },
  "homepage": "https://github.com/wxstack/wxstack#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@wxstack/core": "workspace:*"
  }
}

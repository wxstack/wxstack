{
  "name": "@wxstack/core",
  "version": "0.1.0",
  "description": "wxstack 内核：HTTP 传输、令牌管理、加解密、错误体系、回调内核",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./crypto": {
      "import": {
        "types": "./dist/crypto.d.ts",
        "default": "./dist/crypto.js"
      },
      "require": {
        "types": "./dist/crypto.d.cts",
        "default": "./dist/crypto.cjs"
      }
    },
    "./webhook": {
      "import": {
        "types": "./dist/webhook.d.ts",
        "default": "./dist/webhook.js"
      },
      "require": {
        "types": "./dist/webhook.d.cts",
        "default": "./dist/webhook.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint:pkg": "publint && attw --pack . --profile node16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxstack/wxstack.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/wxstack/wxstack#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}

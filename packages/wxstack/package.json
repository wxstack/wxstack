{
  "name": "wxstack",
  "version": "0.1.0",
  "description": "微信全生态 Node SDK 聚合包：一次安装，按需引入各业务子模块",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./oa": {
      "import": {
        "types": "./dist/oa.d.ts",
        "default": "./dist/oa.js"
      },
      "require": {
        "types": "./dist/oa.d.cts",
        "default": "./dist/oa.cjs"
      }
    },
    "./pay": {
      "import": {
        "types": "./dist/pay.d.ts",
        "default": "./dist/pay.js"
      },
      "require": {
        "types": "./dist/pay.d.cts",
        "default": "./dist/pay.cjs"
      }
    },
    "./mp": {
      "import": {
        "types": "./dist/mp.d.ts",
        "default": "./dist/mp.js"
      },
      "require": {
        "types": "./dist/mp.d.cts",
        "default": "./dist/mp.cjs"
      }
    },
    "./wecom": {
      "import": {
        "types": "./dist/wecom.d.ts",
        "default": "./dist/wecom.js"
      },
      "require": {
        "types": "./dist/wecom.d.cts",
        "default": "./dist/wecom.cjs"
      }
    },
    "./op": {
      "import": {
        "types": "./dist/op.d.ts",
        "default": "./dist/op.js"
      },
      "require": {
        "types": "./dist/op.d.cts",
        "default": "./dist/op.cjs"
      }
    },
    "./shop": {
      "import": {
        "types": "./dist/shop.d.ts",
        "default": "./dist/shop.js"
      },
      "require": {
        "types": "./dist/shop.d.cts",
        "default": "./dist/shop.cjs"
      }
    },
    "./ch": {
      "import": {
        "types": "./dist/ch.d.ts",
        "default": "./dist/ch.js"
      },
      "require": {
        "types": "./dist/ch.d.cts",
        "default": "./dist/ch.cjs"
      }
    },
    "./mg": {
      "import": {
        "types": "./dist/mg.d.ts",
        "default": "./dist/mg.js"
      },
      "require": {
        "types": "./dist/mg.d.cts",
        "default": "./dist/mg.cjs"
      }
    },
    "./ai": {
      "import": {
        "types": "./dist/ai.d.ts",
        "default": "./dist/ai.js"
      },
      "require": {
        "types": "./dist/ai.d.cts",
        "default": "./dist/ai.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint:pkg": "publint && attw --pack . --profile node16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxstack/wxstack.git",
    "directory": "packages/wxstack"
  },
  "homepage": "https://github.com/wxstack/wxstack#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@wxstack/core": "workspace:*",
    "@wxstack/oa": "workspace:*",
    "@wxstack/pay": "workspace:*",
    "@wxstack/mp": "workspace:*",
    "@wxstack/wecom": "workspace:*",
    "@wxstack/op": "workspace:*",
    "@wxstack/shop": "workspace:*",
    "@wxstack/ch": "workspace:*",
    "@wxstack/mg": "workspace:*",
    "@wxstack/ai": "workspace:*"
  }
}

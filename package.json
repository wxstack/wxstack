{
  "name": "wxstack-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "现代化微信全生态 Node SDK（monorepo 根）",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@wxstack/core": "workspace:*",
    "@wxstack/oa": "workspace:*",
    "@wxstack/pay": "workspace:*",
    "@wxstack/mp": "workspace:*",
    "@wxstack/wecom": "workspace:*",
    "@wxstack/op": "workspace:*",
    "@wxstack/shop": "workspace:*",
    "@wxstack/ch": "workspace:*",
    "@wxstack/mg": "workspace:*",
    "@wxstack/ai": "workspace:*",
    "wxstack": "workspace:*",
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.11",
    "@types/node": "^22.10.5",
    "publint": "^0.3.2",
    "tsup": "^8.3.5",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.8",
    "wrangler": "^4.37.1"
  }
}
